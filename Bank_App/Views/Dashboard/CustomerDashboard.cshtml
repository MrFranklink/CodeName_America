@using BankApp.Services
@{
    ViewBag.Title = "Customer Dashboard";
    Layout = "~/Views/Shared/Template.cshtml";
}

@section styles {
    <style>
        .page-header {
      background-color: #f8f9fa;
            padding: 2rem 0;
     margin-bottom: 2rem;
   border-bottom: 1px solid #dee2e6;
        }
        
        .account-card {
 margin-bottom: 1.5rem;
        }
        
        .empty-state {
         text-align: center;
   padding: 3rem 2rem;
  background: #f8f9fa;
      border-radius: 10px;
            margin: 2rem 0;
    }
        
        .transaction-item {
            padding: 1rem;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .transaction-item:last-child {
            border-bottom: none;
   }

 /* Animation for newest transaction */
        .transaction-item.newest {
   animation: highlightNew 2s ease-in-out;
        }

        @@keyframes highlightNew {
         0% {
         background-color: #d4edda;
       transform: scale(1.02);
       }
         50% {
  background-color: #fff3cd;
            }
 100% {
      background-color: transparent;
     transform: scale(1);
            }
      }
    
 /* Tab styling */
        .account-tabs .nav-link {
            color: #495057;
       font-weight: 500;
      border-radius: 0;
}
        
        .account-tabs .nav-link.active {
    color: #198754;
            border-bottom: 3px solid #198754;
     background-color: transparent;
        }
    
    .account-tabs .nav-link:hover {
   color: #198754;
      background-color: #f8f9fa;
        }
    
        /* Tab-specific colors */
        .account-tabs .nav-link[data-tab="rejected"].active {
            color: #dc3545;
     border-bottom-color: #dc3545;
        }
        
     .account-tabs .nav-link[data-tab="closed"].active {
       color: #6c757d;
            border-bottom-color: #6c757d;
        }
    </style>
}

<!-- Simple Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">
            <i class="bi bi-bank2 me-2"></i>Gen Bank
        </a>
        
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
   <span class="navbar-toggler-icon"></span>
        </button>
      
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
        <li class="nav-item dropdown">
               <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
        <i class="bi bi-person-circle me-2"></i>@ViewBag.UserName
     </a>
     <ul class="dropdown-menu dropdown-menu-end">
      <li><a class="dropdown-item" href="#profile" onclick="showSection('profile'); return false;"><i class="bi bi-person me-2"></i>My Profile</a></li>
   <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Dashboard")"><i class="bi bi-key me-2"></i>Change Password</a></li>
       <li><hr class="dropdown-divider"></li>
               <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Auth")"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
             </ul>
     </li>
    </ul>
   </div>
    </div>
</nav>

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <h2>Customer Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, @ViewBag.UserName</p>
    </div>
</div>

<!-- Main Content -->
<div class="container pb-5">
    @if (ViewBag.CustomerAccounts != null && ((List<AccountDTO>)ViewBag.CustomerAccounts).Count > 0)
    {
        var allAccounts = (List<AccountDTO>)ViewBag.CustomerAccounts;
        var pendingAccounts = allAccounts.Where(a => a.Status == "PENDING").ToList();
        var rejectedAccounts = allAccounts.Where(a => a.Status == "REJECTED").ToList();
        var activeAccounts = allAccounts.Where(a => a.Status == "OPEN").ToList();
     var closedAccounts = allAccounts.Where(a => a.Status == "CLOSED").ToList();
 
        @* Pending Accounts Alert *@
        if (pendingAccounts.Any())
        {
   <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <i class="bi bi-hourglass-split me-2"></i>
       <strong>Pending Applications:</strong> You have @pendingAccounts.Count application(s) awaiting manager approval.
             @foreach (var pending in pendingAccounts)
          {
          <span class="badge bg-warning text-dark ms-2">
            @pending.AccountID (@(pending.AccountType == "FIXED-DEPOSIT" ? "FD" : pending.AccountType == "LOAN" ? "Loan" : ""))
                  </span>
      }
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
     </div>
   }
        
        @* Rejected Accounts Alert *@
 if (rejectedAccounts.Any())
     {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
     <i class="bi bi-x-circle me-2"></i>
     <strong>Application Rejected:</strong> @rejectedAccounts.Count application(s) were not approved. 
                <a href="#" onclick="document.querySelector('#rejected-tab').click(); return false;" class="alert-link">View details</a>
             @foreach (var rejected in rejectedAccounts)
     {
         <span class="badge bg-danger ms-2">
 @rejected.AccountID (@(rejected.AccountType == "FIXED-DEPOSIT" ? "FD" : rejected.AccountType == "LOAN" ? "Loan" : ""))
            </span>
                }
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
     </div>
 }
        
        <div class="row mb-4">
         <div class="col-md-4">
   <div class="card">
           <div class="card-body">
          <h6 class="text-muted">Savings Balance</h6>
         <h3 class="text-success">₹ @((ViewBag.SavingsBalance ?? 0m).ToString("N2"))</h3>
       </div>
     </div>
            </div>
       <div class="col-md-4">
     <div class="card">
              <div class="card-body">
           <h6 class="text-muted">Active Accounts</h6>
   <h3 class="text-primary">@activeAccounts.Count</h3>
         </div>
       </div>
            </div>
            <div class="col-md-4">
         <div class="card">
  <div class="card-body">
     <h6 class="text-muted">Transactions</h6>
   <h3 class="text-info">@(ViewBag.TransactionCount ?? 0)</h3>
   </div>
   </div>
     </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mb-4">
          <div class="col-md-3">
             <button class="btn btn-primary w-100" onclick="showSection('transfer')">
   <i class="bi bi-arrow-left-right me-2"></i>Transfer Funds
    </button>
            </div>
        <div class="col-md-3">
         <button class="btn btn-success w-100" onclick="showSection('pay-emi')">
         <i class="bi bi-cash-coin me-2"></i>Pay EMI
        </button>
          </div>
            <div class="col-md-3">
       <button class="btn btn-info w-100 text-white" onclick="showSection('apply-fd')">
     <i class="bi bi-graph-up-arrow me-2"></i>Apply for FD
   </button>
     </div>
     <div class="col-md-3">
        <button class="btn btn-warning w-100" onclick="showSection('apply-loan')">
               <i class="bi bi-credit-card me-2"></i>Apply for Loan
       </button>
</div>
     </div>

        <!-- Quick Actions - Second Row -->
        <div class="row mb-4">
    <div class="col-md-12">
     <button class="btn btn-secondary w-100" onclick="showSection('history')">
  <i class="bi bi-clock-history me-2"></i>Transaction History
         </button>
     </div>
        </div>

  <!-- Accounts Tabs Section -->
        <div class="card mb-4">
     <div class="card-header bg-white">
         <h5 class="mb-3"><i class="bi bi-folder2-open me-2"></i>My Accounts</h5>
                <ul class="nav nav-tabs account-tabs border-0" id="accountTabs" role="tablist">
 <li class="nav-item" role="presentation">
           <button class="nav-link active" id="active-tab" data-bs-toggle="tab" data-bs-target="#active-accounts" type="button" role="tab" data-tab="active">
  <i class="bi bi-check-circle me-2"></i>Active 
   <span class="badge bg-success ms-1">@(activeAccounts.Count + pendingAccounts.Count)</span>
             </button>
       </li>
        <li class="nav-item" role="presentation">
 <button class="nav-link" id="rejected-tab" data-bs-toggle="tab" data-bs-target="#rejected-accounts" type="button" role="tab" data-tab="rejected">
    <i class="bi bi-x-circle me-2"></i>Rejected 
     <span class="badge bg-danger ms-1">@rejectedAccounts.Count</span>
    </button>
 </li>
     <li class="nav-item" role="presentation">
   <button class="nav-link" id="closed-tab" data-bs-toggle="tab" data-bs-target="#closed-accounts" type="button" role="tab" data-tab="closed">
           <i class="bi bi-lock me-2"></i>Closed 
    <span class="badge bg-secondary ms-1">@closedAccounts.Count</span>
            </button>
        </li>
      </ul>
  </div>
       <div class="card-body">
            <div class="tab-content" id="accountTabContent">
<!-- Active Accounts Tab -->
     <div class="tab-pane fade show active" id="active-accounts" role="tabpanel">
 @if (activeAccounts.Any() || pendingAccounts.Any())
         {
        <div class="row">
                @foreach (var account in allAccounts.Where(a => a.Status == "OPEN" || a.Status == "PENDING"))
      {
    var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(account.AccountID, account.AccountType);
           
            // Determine border color based on status
        string borderClass = account.Status == "PENDING" ? "border-warning" : 
     account.AccountType == "SAVING" ? "border-success" : 
        account.AccountType == "FIXED-DEPOSIT" ? "border-info" : "border-warning";
      
          <div class="col-md-4">
           <div class="card account-card @borderClass">
 <div class="card-header bg-@(account.AccountType == "SAVING" ? "success" : account.AccountType == "FIXED-DEPOSIT" ? "info" : "warning") text-white">
            <div class="d-flex justify-content-between align-items-center">
      <h6 class="mb-0">
      <i class="bi bi-@(account.AccountType == "SAVING" ? "piggy-bank" : account.AccountType == "FIXED-DEPOSIT" ? "graph-up-arrow" : "credit-card") me-2"></i>
       @(account.AccountType == "SAVING" ? "Savings" : account.AccountType == "FIXED-DEPOSIT" ? "Fixed Deposit" : "Loan")
    </h6>
           
   @if (account.Status == "PENDING")
       {
 <span class="badge bg-warning text-dark">
         <i class="bi bi-hourglass-split me-1"></i>Pending
            </span>
      }
   else if (account.Status == "OPEN")
           {
   <span class="badge bg-light text-dark">
  <i class="bi bi-check-circle me-1"></i>Active
     </span>
              }
 </div>
        </div>
    <div class="card-body">
       <p class="text-muted mb-1">@account.AccountID</p>
         
  @if (account.Status == "PENDING")
        {
       <div class="alert alert-warning mb-0">
            <i class="bi bi-hourglass-split me-2"></i>
 <strong>Awaiting Approval</strong>
    <p class="mb-0 small mt-2">Your application is under review by our manager. You'll be notified once it's approved.</p>
             @if (account.AccountType == "FIXED-DEPOSIT")
           {
             <p class="mb-0 small mt-2">
         <strong>Amount:</strong> ₹ @accountDetails.Amount.ToString("N2")<br>
        <strong>Interest:</strong> @accountDetails.InterestRate% p.a.
         </p>
    }
       else if (account.AccountType == "LOAN")
  {
    <p class="mb-0 small mt-2">
    <strong>Loan:</strong> ₹ @accountDetails.LoanAmount.ToString("N2")<br>
       <strong>EMI:</strong> ₹ @accountDetails.EMI.ToString("N2")<br>
     <strong>Interest:</strong> @accountDetails.InterestRate% p.a.
        </p>
     }
            </div>
           }
         else if (account.Status == "OPEN")
   {
        if (account.AccountType == "SAVING")
                      {
        <h4 class="text-success">₹ @accountDetails.Balance.ToString("N2")</h4>
        <small class="text-muted">Available Balance</small>
             }
               else if (account.AccountType == "FIXED-DEPOSIT")
        {
    <h4 class="text-info">₹ @accountDetails.MaturityAmount.ToString("N2")</h4>
          <small class="text-muted">Maturity | @accountDetails.InterestRate% p.a.</small>
  }
             else
              {
        <h4 class="text-warning">₹ @accountDetails.EMI.ToString("N2")</h4>
      <small class="text-muted">Monthly EMI | @accountDetails.InterestRate% p.a.</small>
       
       @* Show loan outstanding below EMI *@
    <div class="mt-3 pt-3 border-top">
  <div class="d-flex justify-content-between align-items-center">
         <span class="text-muted small">
        <i class="bi bi-cash-stack me-1"></i>Loan Outstanding:
         </span>
        <span class="fw-bold text-warning loan-outstanding-@account.AccountID" data-loan-id="@account.AccountID">
       <span class="spinner-border spinner-border-sm" role="status"></span>
         </span>
      </div>
             <div class="progress mt-2" style="height: 8px;">
        <div class="progress-bar bg-success loan-progress-@account.AccountID" role="progressbar" style="width: 0%"></div>
        </div>
         <small class="text-muted">
             <span class="loan-paid-@account.AccountID">Calculating...</span>
     </small>
      </div>
  }
    }
      </div>
        </div>
        </div>
            }
        </div>
      }
                  else
               {
   <div class="alert alert-info text-center">
  <i class="bi bi-info-circle me-2"></i>
  <strong>No active accounts found.</strong>
         <p class="mb-0 mt-2">Apply for a Fixed Deposit or Loan using the buttons above.</p>
</div>
                }
    </div>
            
         <!-- Rejected Accounts Tab -->
   <div class="tab-pane fade" id="rejected-accounts" role="tabpanel">
          @if (rejectedAccounts.Any())
              {
        <div class="alert alert-warning mb-3">
       <i class="bi bi-exclamation-triangle me-2"></i>
       <strong>Application Rejections:</strong> The following applications were not approved. 
            Please contact customer service for more information or to reapply.
                </div>
           
         <div class="row">
          @foreach (var account in rejectedAccounts)
 {
                  var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(account.AccountID, account.AccountType);
        
      <div class="col-md-4">
    <div class="card account-card border-danger">
       <div class="card-header bg-danger text-white">
  <div class="d-flex justify-content-between align-items-center">
       <h6 class="mb-0">
   <i class="bi bi-@(account.AccountType == "SAVING" ? "piggy-bank" : account.AccountType == "FIXED-DEPOSIT" ? "graph-up-arrow" : "credit-card") me-2"></i>
          @(account.AccountType == "SAVING" ? "Savings" : account.AccountType == "FIXED-DEPOSIT" ? "Fixed Deposit" : "Loan")
                 </h6>
     <span class="badge bg-light text-danger">
         <i class="bi bi-x-circle me-1"></i>Rejected
   </span>
       </div>
             </div>
          <div class="card-body">
        <p class="text-muted mb-1">@account.AccountID</p>
         
     <div class="alert alert-danger mb-0">
      <i class="bi bi-x-circle me-2"></i>
         <strong>Application Rejected</strong>
        <p class="mb-0 small mt-2">Your application was not approved.</p>
   
         @* Show rejection reason if available *@
    @if (!string.IsNullOrEmpty(account.RejectionReason))
          {
              <div class="mt-2 p-2 bg-light rounded">
   <strong class="small">Reason:</strong>
    <p class="mb-0 small">@account.RejectionReason</p>
              </div>
 }
     
               @* Show application details *@
   @if (account.AccountType == "FIXED-DEPOSIT")
  {
        <p class="mb-0 small mt-2 text-muted">
<strong>Requested Amount:</strong> ₹ @accountDetails.Amount.ToString("N2")<br>
          <strong>Tenure:</strong> @accountDetails.Tenure months<br>
    <strong>Applied on:</strong> @account.OpenDate.ToString("dd MMM yyyy")
          </p>
             }
 else if (account.AccountType == "LOAN")
  {
            <p class="mb-0 small mt-2 text-muted">
  <strong>Requested Loan:</strong> ₹ @accountDetails.LoanAmount.ToString("N2")<br>
      <strong>EMI:</strong> ₹ @accountDetails.EMI.ToString("N2")<br>
    <strong>Applied on:</strong> @account.OpenDate.ToString("dd MMM yyyy")
      </p>
           }
             
       <div class="mt-3">
            <button class="btn btn-sm btn-outline-primary" onclick="showContactInfo()">
      <i class="bi bi-telephone me-1"></i>Contact Support
    </button>
                  </div>
      </div>
        </div>
            </div>
        </div>
                   }
           </div>
            }
        else
            {
    <div class="alert alert-success text-center">
     <i class="bi bi-check-circle me-2"></i>
  <strong>No rejected applications!</strong>
 <p class="mb-0 mt-2">All your applications have been approved or are pending review.</p>
     </div>
            }
            </div>
           
     <!-- Closed Accounts Tab -->
          <div class="tab-pane fade" id="closed-accounts" role="tabpanel">
               @if (closedAccounts.Any())
        {
 <div class="alert alert-info mb-3">
           <i class="bi bi-info-circle me-2"></i>
              <strong>Closed Accounts:</strong> These accounts have been closed. The information is kept for your records.
           </div>
         
        <div class="row">
   @foreach (var account in closedAccounts)
       {
       var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(account.AccountID, account.AccountType);
      
 <div class="col-md-4">
        <div class="card account-card border-secondary">
            <div class="card-header bg-secondary text-white">
       <div class="d-flex justify-content-between align-items-center">
   <h6 class="mb-0">
          <i class="bi bi-@(account.AccountType == "SAVING" ? "piggy-bank" : account.AccountType == "FIXED-DEPOSIT" ? "graph-up-arrow" : "credit-card") me-2"></i>
      @(account.AccountType == "SAVING" ? "Savings" : account.AccountType == "FIXED-DEPOSIT" ? "Fixed Deposit" : "Loan")
    </h6>
     <span class="badge bg-light text-dark">
         <i class="bi bi-lock me-1"></i>Closed
  </span>
 </div>
              </div>
               <div class="card-body">
    <p class="text-muted mb-1">@account.AccountID</p>
               
  <div class="alert alert-secondary mb-0">
   <i class="bi bi-lock me-2"></i>
        <strong>Account Closed</strong>
           <p class="mb-0 small mt-2">
           This account was closed on <strong>@(account.ClosedDate?.ToString("dd MMM yyyy") ?? "N/A")</strong>
        </p>
         
             @* Show final details for reference *@
       @if (account.AccountType == "SAVING")
         {
       <p class="mb-0 small mt-2">
          <strong>Final Balance:</strong> ₹ @accountDetails.Balance.ToString("N2")
</p>
 }
         else if (account.AccountType == "FIXED-DEPOSIT")
                  {
   <p class="mb-0 small mt-2">
      <strong>Maturity Amount:</strong> ₹ @accountDetails.MaturityAmount.ToString("N2")<br>
       <strong>Interest Rate:</strong> @accountDetails.InterestRate% p.a.
       </p>
      }
           else if (account.AccountType == "LOAN")
  {
       <p class="mb-0 small mt-2">
 <strong>Original Loan:</strong> ₹ @accountDetails.LoanAmount.ToString("N2")<br>
          <strong>Monthly EMI:</strong> ₹ @accountDetails.EMI.ToString("N2")
          </p>
         }
     </div>
      </div>
         </div>
      </div>
             }
    </div>
  }
     else
        {
            <div class="alert alert-success text-center">
       <i class="bi bi-check-circle me-2"></i>
          <strong>No closed accounts.</strong>
        <p class="mb-0 mt-2">All your accounts are currently active.</p>
    </div>
}
        </div>
      </div>
        </div>
     </div>
    }
    else
    {
      <!-- Empty State -->
        <div class="empty-state">
         <div class="mb-4">
           <i class="bi bi-bank2 text-muted" style="font-size: 4rem;"></i>
     </div>
   <h3>No Accounts Yet</h3>
  <p class="text-muted">
            Visit your nearest branch or contact customer service to open a savings account, fixed deposit, or apply for a loan.
         </p>
         <div class="row mt-4">
<div class="col-md-4">
          <div class="card">
           <div class="card-body text-center">
     <i class="bi bi-piggy-bank-fill text-success" style="font-size: 2rem;"></i>
  <h5 class="mt-2">Savings Account</h5>
       <p class="text-muted small">Competitive interest rates</p>
           </div>
      </div>
   </div>
     <div class="col-md-4">
          <div class="card">
       <div class="card-body text-center">
      <i class="bi bi-graph-up-arrow text-info" style="font-size: 2rem;"></i>
             <h5 class="mt-2">Fixed Deposit</h5>
  <p class="text-muted small">Guaranteed returns</p>
 </div>
            </div>
          </div>
                <div class="col-md-4">
        <div class="card">
  <div class="card-body text-center">
     <i class="bi bi-credit-card-fill text-warning" style="font-size: 2rem;"></i>
      <h5 class="mt-2">Personal Loan</h5>
             <p class="text-muted small">Flexible repayment</p>
             </div>
        </div>
           </div>
            </div>
            <button class="btn btn-primary mt-4" onclick="showContactInfo()">
       <i class="bi bi-telephone-fill me-2"></i>Contact Customer Service
            </button>
        </div>
    }

    <!-- Profile Section -->
    <div id="profile" class="card" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>My Profile</h5>
        </div>
        <div class="card-body">
     @if (ViewBag.CustomerProfile != null)
  {
        var profile = (CustomerProfileDTO)ViewBag.CustomerProfile;
                <table class="table">
   <tr>
  <td><strong>Customer Name</strong></td>
      <td>@profile.Custname</td>
   </tr>
   <tr>
     <td><strong>Customer ID</strong></td>
           <td>@profile.Custid</td>
             </tr>
             <tr>
          <td><strong>Date of Birth</strong></td>
       <td>@(profile.DOB?.ToString("dd/MM/yyyy") ?? "N/A")</td>
           </tr>
    <tr>
         <td><strong>PAN Number</strong></td>
       <td>@profile.Pan</td>
         </tr>
        <tr>
   <td><strong>Phone Number</strong></td>
 <td>@(profile.PhoneNumber ?? "Not Provided")</td>
          </tr>
        <tr>
        <td><strong>Address</strong></td>
 <td>@(profile.Address ?? "Not Provided")</td>
          </tr>
         </table>
       }
        </div>
    </div>

    <!-- Transfer Funds Section -->
    <div id="transfer" class="card" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Transfer Funds</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.CustomerAccounts != null)
            {
                var savingsAccount = ((List<AccountDTO>)ViewBag.CustomerAccounts).FirstOrDefault(a => a.AccountType == "SAVING" && a.Status == "OPEN");
                
                if (savingsAccount != null)
                {
                    var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(savingsAccount.AccountID, savingsAccount.AccountType);
                    
                    <div class="alert alert-info">
                        <strong>From:</strong> @savingsAccount.AccountID | 
                        <strong>Available:</strong> ₹ @((accountDetails.Balance - 1000 > 0 ? accountDetails.Balance - 1000 : 0).ToString("N2"))
                    </div>

                    <form method="post" action="@Url.Action("TransferFunds", "Dashboard")">
                        <div class="mb-3">
