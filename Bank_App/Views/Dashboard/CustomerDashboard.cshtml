@using BankApp.Services
@{
    ViewBag.Title = "Customer Dashboard";
    Layout = "~/Views/Shared/Template.cshtml";
}

@section styles {
    <style>
        .page-header {
            background-color: #f8f9fa;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-bottom: 1px solid #dee2e6;
        }
        
        .account-card {
            margin-bottom: 1.5rem;
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            background: #f8f9fa;
            border-radius: 10px;
            margin: 2rem 0;
        }
        
        .transaction-item {
            padding: 1rem;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .transaction-item:last-child {
            border-bottom: none;
        }
    </style>
}

<!-- Simple Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">
            <i class="bi bi-bank2 me-2"></i>Gen Bank
        </a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-2"></i>@ViewBag.UserName
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#profile" onclick="showSection('profile'); return false;"><i class="bi bi-person me-2"></i>My Profile</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Dashboard")"><i class="bi bi-key me-2"></i>Change Password</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Auth")"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Page Header -->
<div class="page-header">
    <div class="container">
        <h2>Customer Dashboard</h2>
        <p class="text-muted mb-0">Welcome back, @ViewBag.UserName</p>
    </div>
</div>

<!-- Main Content -->
<div class="container pb-5">
    <!-- Account Summary -->
    @if (ViewBag.CustomerAccounts != null && ((List<AccountDTO>)ViewBag.CustomerAccounts).Count > 0)
    {
        @* Check for pending or rejected accounts *@
        
            var allAccounts = (List<AccountDTO>)ViewBag.CustomerAccounts;
            var pendingAccounts = allAccounts.Where(a => a.Status == "PENDING").ToList();
            var rejectedAccounts = allAccounts.Where(a => a.Status == "REJECTED").ToList();
       
        
        @* Pending Accounts Alert *@
        if (pendingAccounts.Any())
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-hourglass-split me-2"></i>
                <strong>Pending Applications:</strong> You have @pendingAccounts.Count application(s) awaiting manager approval.
                @foreach (var pending in pendingAccounts)
                {
                    <span class="badge bg-warning text-dark ms-2">
                        @pending.AccountID (@(pending.AccountType == "FIXED-DEPOSIT" ? "FD" : pending.AccountType == "LOAN" ? "Loan" : ""))
                    </span>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @* Rejected Accounts Alert *@
        if (rejectedAccounts.Any())
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-circle me-2"></i>
                <strong>Application Rejected:</strong> @rejectedAccounts.Count application(s) were not approved. Please check your account cards below for details.
                @foreach (var rejected in rejectedAccounts)
                {
                    <span class="badge bg-danger ms-2">
                        @rejected.AccountID (@(rejected.AccountType == "FIXED-DEPOSIT" ? "FD" : rejected.AccountType == "LOAN" ? "Loan" : ""))
                    </span>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted">Savings Balance</h6>
                        <h3 class="text-success">₹ @((ViewBag.SavingsBalance ?? 0m).ToString("N2"))</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted">Active Accounts</h6>
                        <h3 class="text-primary">@(ViewBag.TotalAccounts ?? 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted">Transactions</h6>
                        <h3 class="text-info">@(ViewBag.TransactionCount ?? 0)</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mb-4">
            <div class="col-md-3">
                <button class="btn btn-primary w-100" onclick="showSection('transfer')">
                    <i class="bi bi-arrow-left-right me-2"></i>Transfer Funds
                </button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-success w-100" onclick="showSection('pay-emi')">
                    <i class="bi bi-cash-coin me-2"></i>Pay EMI
                </button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-info w-100 text-white" onclick="showSection('apply-fd')">
                    <i class="bi bi-graph-up-arrow me-2"></i>Apply for FD
                </button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-warning w-100" onclick="showSection('apply-loan')">
                    <i class="bi bi-credit-card me-2"></i>Apply for Loan
                </button>
            </div>
        </div>

        <!-- Quick Actions - Second Row -->
        <div class="row mb-4">
            <div class="col-md-12">
                <button class="btn btn-secondary w-100" onclick="showSection('history')">
                    <i class="bi bi-clock-history me-2"></i>Transaction History
                </button>
            </div>
        </div>

        <!-- Account Cards -->
        <div class="row mb-4">
            @foreach (var account in (List<AccountDTO>)ViewBag.CustomerAccounts)
            {
                var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(account.AccountID, account.AccountType);
                
                // Determine border color based on status
                string borderClass = account.Status == "OPEN" ? "border-success" : 
                                    account.Status == "PENDING" ? "border-warning" : 
                                    account.Status == "REJECTED" ? "border-danger" : "border-secondary";
                
                // Only show account type color for OPEN accounts
                if (account.Status == "OPEN")
                {
                    borderClass = account.AccountType == "SAVING" ? "border-success" : 
                                  account.AccountType == "FIXED-DEPOSIT" ? "border-info" : "border-warning";
                }
                
                <div class="col-md-4">
                    <div class="card account-card @borderClass">
                        <div class="card-header bg-@(account.AccountType == "SAVING" ? "success" : account.AccountType == "FIXED-DEPOSIT" ? "info" : "warning") text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">
                                    <i class="bi bi-@(account.AccountType == "SAVING" ? "piggy-bank" : account.AccountType == "FIXED-DEPOSIT" ? "graph-up-arrow" : "credit-card") me-2"></i>
                                    @(account.AccountType == "SAVING" ? "Savings" : account.AccountType == "FIXED-DEPOSIT" ? "Fixed Deposit" : "Loan")
                                </h6>
                                
                                <!-- Status Badge -->
                                @if (account.Status == "PENDING")
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-hourglass-split me-1"></i>Pending
                                    </span>
                                }
                                else if (account.Status == "REJECTED")
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle me-1"></i>Rejected
                                    </span>
                                }
                                else if (account.Status == "OPEN")
                                {
                                    <span class="badge bg-light text-dark">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                }
                                else if (account.Status == "CLOSED")
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-lock me-1"></i>Closed
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-1">@account.AccountID</p>
                            
                            @if (account.Status == "PENDING")
                            {
                                <!-- Pending Application -->
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-hourglass-split me-2"></i>
                                    <strong>Awaiting Approval</strong>
                                    <p class="mb-0 small mt-2">Your application is under review by our manager. You'll be notified once it's approved.</p>
                                    @if (account.AccountType == "FIXED-DEPOSIT")
                                    {
                                        <p class="mb-0 small mt-2">
                                            <strong>Amount:</strong> ₹ @accountDetails.Amount.ToString("N2")<br>
                                            <strong>Interest:</strong> @accountDetails.InterestRate% p.a.
                                        </p>
                                    }
                                    else if (account.AccountType == "LOAN")
                                    {
                                        <p class="mb-0 small mt-2">
                                            <strong>Loan:</strong> ₹ @accountDetails.LoanAmount.ToString("N2")<br>
                                            <strong>EMI:</strong> ₹ @accountDetails.EMI.ToString("N2")<br>
                                            <strong>Interest:</strong> @accountDetails.InterestRate% p.a.
                                        </p>
                                    }
                                </div>
                            }
                            else if (account.Status == "REJECTED")
                            {
                                <!-- Rejected Application -->
                                <div class="alert alert-danger mb-0">
                                    <i class="bi bi-x-circle me-2"></i>
                                    <strong>Application Rejected</strong>
                                    <p class="mb-0 small mt-2">Your application was not approved. Please contact customer service for more information.</p>
                                    @* TODO: Display rejection reason when available *@
                                </div>
                            }
                            else if (account.Status == "CLOSED")
                            {
                                <!-- Closed Account -->
                                <div class="alert alert-secondary mb-0">
                                    <i class="bi bi-lock me-2"></i>
                                    <strong>Account Closed</strong>
                                    <p class="mb-0 small mt-2">This account has been closed on @(account.ClosedDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                                </div>
                            }
                            else if (account.Status == "OPEN")
                            {
                                <!-- Active Account - Show Details -->
                                if (account.AccountType == "SAVING")
                                {
                                    <h4 class="text-success">₹ @accountDetails.Balance.ToString("N2")</h4>
                                    <small class="text-muted">Available Balance</small>
                                }
                                else if (account.AccountType == "FIXED-DEPOSIT")
                                {
                                    <h4 class="text-info">₹ @accountDetails.MaturityAmount.ToString("N2")</h4>
                                    <small class="text-muted">Maturity | @accountDetails.InterestRate% p.a.</small>
                                }
                                else
                                {
                                    <h4 class="text-warning">₹ @accountDetails.EMI.ToString("N2")</h4>
                                    <small class="text-muted">Monthly EMI | @accountDetails.InterestRate% p.a.</small>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="mb-4">
                <i class="bi bi-bank2 text-muted" style="font-size: 4rem;"></i>
            </div>
            <h3>No Accounts Yet</h3>
            <p class="text-muted">
                Visit your nearest branch or contact customer service to open a savings account, fixed deposit, or apply for a loan.
            </p>
            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="bi bi-piggy-bank-fill text-success" style="font-size: 2rem;"></i>
                            <h5 class="mt-2">Savings Account</h5>
                            <p class="text-muted small">Competitive interest rates</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="bi bi-graph-up-arrow text-info" style="font-size: 2rem;"></i>
                            <h5 class="mt-2">Fixed Deposit</h5>
                            <p class="text-muted small">Guaranteed returns</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="bi bi-credit-card-fill text-warning" style="font-size: 2rem;"></i>
                            <h5 class="mt-2">Personal Loan</h5>
                            <p class="text-muted small">Flexible repayment</p>
                        </div>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary mt-4" onclick="showContactInfo()">
                <i class="bi bi-telephone-fill me-2"></i>Contact Customer Service
            </button>
        </div>
    }

    <!-- Profile Section -->
    <div id="profile" class="card" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>My Profile</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.CustomerProfile != null)
            {
                var profile = (CustomerProfileDTO)ViewBag.CustomerProfile;
                <table class="table">
                    <tr>
                        <td><strong>Customer Name</strong></td>
                        <td>@profile.Custname</td>
                    </tr>
                    <tr>
                        <td><strong>Customer ID</strong></td>
                        <td>@profile.Custid</td>
                    </tr>
                    <tr>
                        <td><strong>Date of Birth</strong></td>
                        <td>@(profile.DOB?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    </tr>
                    <tr>
                        <td><strong>PAN Number</strong></td>
                        <td>@profile.Pan</td>
                    </tr>
                    <tr>
                        <td><strong>Phone Number</strong></td>
                        <td>@(profile.PhoneNumber ?? "Not Provided")</td>
                    </tr>
                    <tr>
                        <td><strong>Address</strong></td>
                        <td>@(profile.Address ?? "Not Provided")</td>
                    </tr>
                </table>
            }
        </div>
    </div>

    <!-- Transfer Funds Section -->
    <div id="transfer" class="card" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Transfer Funds</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.CustomerAccounts != null)
            {
                var savingsAccount = ((List<AccountDTO>)ViewBag.CustomerAccounts).FirstOrDefault(a => a.AccountType == "SAVING" && a.Status == "OPEN");
                
                if (savingsAccount != null)
                {
                    var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(savingsAccount.AccountID, savingsAccount.AccountType);
                    
                    <div class="alert alert-info">
                        <strong>From:</strong> @savingsAccount.AccountID | 
                        <strong>Available:</strong> ₹ @((accountDetails.Balance - 1000 > 0 ? accountDetails.Balance - 1000 : 0).ToString("N2"))
                    </div>

                    <form method="post" action="@Url.Action("TransferFunds", "Dashboard")">
                        <div class="mb-3">
                            <label class="form-label">Recipient Account ID (SB00001)</label>
                            <input name="toAccountId" type="text" class="form-control" maxlength="7" style="text-transform: uppercase;" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Transfer Amount (₹)</label>
                            <input name="amount" type="number" class="form-control" step="0.01" min="100" max="100000" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Remarks (Optional)</label>
                            <input name="remarks" type="text" class="form-control" maxlength="100">
                        </div>
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirm transfer?');">
                            <i class="bi bi-arrow-right-circle me-2"></i>Transfer Now
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning">
                        You need an active savings account to transfer funds.
                    </div>
                }
            }
        </div>
    </div>

    <!-- Pay EMI Section -->
    <div id="pay-emi" class="card" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Pay Loan EMI</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.CustomerAccounts != null)
            {
                var savingsAccount = ((List<AccountDTO>)ViewBag.CustomerAccounts).FirstOrDefault(a => a.AccountType == "SAVING" && a.Status == "OPEN");
                var loanAccounts = ((List<AccountDTO>)ViewBag.CustomerAccounts).Where(a => a.AccountType == "LOAN" && a.Status == "OPEN").ToList();
                
                if (savingsAccount == null)
                {
                    <div class="alert alert-warning">You need a savings account to pay loan EMI.</div>
                }
                else if (!loanAccounts.Any())
                {
                    <div class="alert alert-info">You don't have any active loan accounts.</div>
                }
                else
                {
                    foreach (var loan in loanAccounts)
                    {
                        var loanDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(loan.AccountID, loan.AccountType);
                        
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6>@loan.AccountID</h6>
                                <p class="small mb-3">
                                    <strong>Loan:</strong> ₹ @loanDetails.LoanAmount.ToString("N2") | 
                                    <strong>EMI:</strong> ₹ @loanDetails.EMI.ToString("N2")
                                </p>
                                
                                <form method="post" action="@Url.Action("PayLoanEMI", "Dashboard")">
                                    <input type="hidden" name="loanAccountId" value="@loan.AccountID" />
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Payment Type</label>
                                            <select name="paymentType" class="form-select" required>
                                                <option value="EMI">Regular EMI (₹ @loanDetails.EMI.ToString("N2"))</option>
                                                <option value="PART_PAYMENT">Part Payment</option>
                                                <option value="FULL_CLOSURE">Full Closure</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">Payment Amount (₹)</label>
                                            <input name="paymentAmount" type="number" class="form-control" step="0.01" min="@loanDetails.EMI" value="@loanDetails.EMI" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-success" onclick="return confirm('Confirm payment?');">
                                        <i class="bi bi-check-circle me-2"></i>Pay Now
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>

    <!-- Transaction History Section -->
    <div id="history" class="card" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Transaction History</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.CustomerAccounts != null)
            {
                var savingsAccounts = ((List<AccountDTO>)ViewBag.CustomerAccounts).Where(a => a.AccountType == "SAVING" && a.Status == "OPEN").ToList();
                
                if (savingsAccounts.Any())
                {
                    foreach (var account in savingsAccounts)
                    {
                        var accountDetails = ((AccountManagementService)new AccountManagementService()).GetAccountDetails(account.AccountID, account.AccountType);
                        
                        <div class="d-flex justify-content-between align-items-center mb-3 p-3 border rounded">
                            <div>
                                <h6 class="mb-0">@account.AccountID</h6>
                                <small class="text-muted">Balance: ₹ @accountDetails.Balance.ToString("N2")</small>
                            </div>
                            <button class="btn btn-primary btn-sm" onclick="viewTransactionHistory('@account.AccountID')">
                                <i class="bi bi-list-ul me-1"></i>View
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">You don't have any active savings accounts.</div>
                }
            }
        </div>
    </div>

    <!-- Apply for Fixed Deposit Section -->
    <div id="apply-fd" class="card" style="display: none;">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Apply for Fixed Deposit</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Benefits of Fixed Deposit:</strong> Guaranteed returns, higher interest rates than savings account.
                <br><strong>Interest Rates:</strong> 6% (<1yr), 7% (1-2yr), 8% (>2yr). Senior citizens: +0.5% bonus.
            </div>

            <form method="post" action="@Url.Action("ApplyForFixedDeposit", "Dashboard")" id="fdApplicationForm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Deposit Amount (Min ₹10,000)</label>
                        <input name="amount" id="fdAmount" type="number" class="form-control" step="0.01" min="10000" required>
                        <small class="text-muted">Minimum deposit: ₹10,000</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tenure (Months)</label>
                        <select name="tenureMonths" id="fdTenure" class="form-select" required>
                            <option value="">Select Tenure</option>
                            <option value="6">6 Months (6% p.a.)</option>
                            <option value="12">12 Months (7% p.a.)</option>
                            <option value="24">24 Months (7% p.a.)</option>
                            <option value="36">36 Months (8% p.a.)</option>
                            <option value="60">60 Months (8% p.a.)</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Start Date</label>
                        <input name="startDate" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estimated Maturity Amount</label>
                        <input type="text" id="fdMaturityAmount" class="form-control" readonly>
                        <small class="text-muted">Auto-calculated</small>
                    </div>
                </div>

                <div id="fdCalculation" class="alert alert-success" style="display:none;">
                    <h6 class="mb-2"><i class="bi bi-calculator me-2"></i>FD Calculation</h6>
                    <p class="mb-1"><strong>Deposit Amount:</strong> ₹<span id="fdCalcAmount">0</span></p>
                    <p class="mb-1"><strong>Interest Rate:</strong> <span id="fdCalcRate">0</span>% p.a.</p>
                    <p class="mb-1"><strong>Tenure:</strong> <span id="fdCalcTenure">0</span> months</p>
                    <p class="mb-0"><strong>Maturity Amount:</strong> ₹<span id="fdCalcMaturity">0</span></p>
                </div>

                <button type="submit" class="btn btn-info text-white" id="fdSubmitBtn">
                    <i class="bi bi-send me-2"></i>Submit FD Application
                </button>
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('apply-fd').style.display='none';">
                    Cancel
                </button>
            </form>
        </div>
    </div>

    <!-- Apply for Loan Section -->
    <div id="apply-loan" class="card" style="display: none;">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Apply for Personal Loan</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Loan Eligibility:</strong> Based on your monthly salary, you can borrow 30-60 times your salary. 
                EMI should not exceed 60% of your salary.
            </div>

            <div id="loanEligibilityCard" class="alert alert-success" style="display:none;">
                <h6 class="mb-2"><i class="bi bi-calculator me-2"></i>Loan Eligibility</h6>
                <p class="mb-1"><strong>Eligible Loan Range:</strong> <span id="loanRange">-</span></p>
                <p class="mb-1"><strong>Interest Rate:</strong> <span id="interestRate">-</span></p>
                <p class="mb-0"><strong>Max EMI (60% of salary):</strong> <span id="maxEmi">-</span></p>
            </div>

            <div id="loanValidationMessage" class="alert" style="display:none;"></div>

            <form method="post" action="@Url.Action("ApplyForLoan", "Dashboard")" id="loanApplicationForm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Monthly Salary (₹)</label>
                        <input name="monthlySalary" id="monthlySalary" type="number" class="form-control" step="0.01" min="1000" required>
                        <small class="text-muted">Enter salary first to see loan eligibility</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Loan Amount (Min ₹10,000)</label>
                        <input name="loanAmount" id="loanAmount" type="number" class="form-control" step="0.01" min="10000" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tenure (Months)</label>
                        <input name="tenureMonths" id="tenureMonths" type="number" class="form-control" min="1" max="360" required>
                        <small class="text-muted">1 to 360 months (30 years)</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Start Date</label>
                        <input name="startDate" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estimated EMI (₹)</label>
                        <input type="text" id="estimatedEmi" class="form-control" readonly>
                        <small class="text-muted">Auto-calculated based on amount & tenure</small>
                    </div>
                </div>

                <button type="submit" id="loanSubmitBtn" class="btn btn-warning" disabled>
                    <i class="bi bi-send me-2"></i>Submit Loan Application
                </button>
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('apply-loan').style.display='none';">
                    Cancel
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Transaction Modal -->
<div class="modal fade" id="transactionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>Transaction History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Account ID:</strong> <span id="modalAccountId"></span></p>
                <div id="modalLoading" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-primary"></div>
                </div>
                <div id="modalError" class="alert alert-danger" style="display:none;"></div>
                <div id="modalContent">
                    <div id="transactionList"></div>
                    <div id="noTransactions" class="alert alert-info" style="display:none;">No transactions found.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact Modal -->
<div class="modal fade" id="contactModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-telephone-fill me-2"></i>Contact Us</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="list-group">
                    <div class="list-group-item">
                        <i class="bi bi-telephone-fill text-primary me-2"></i>
                        <strong>Phone:</strong> 1800-XXX-XXXX
                    </div>
                    <div class="list-group-item">
                        <i class="bi bi-envelope-fill text-success me-2"></i>
                        <strong>Email:</strong> support@bankingsystem.com
                    </div>
                    <div class="list-group-item">
                        <i class="bi bi-clock-fill text-info me-2"></i>
                        <strong>Hours:</strong> Mon-Fri: 9 AM - 5 PM
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function showContactInfo() {
            new bootstrap.Modal(document.getElementById('contactModal')).show();
        }

        function showSection(sectionId) {
            document.querySelectorAll('.card[id]').forEach(el => el.style.display = 'none');
            var section = document.getElementById(sectionId);
            if (section) {
                section.style.display = 'block';
                section.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function viewTransactionHistory(accountId) {
            var modal = new bootstrap.Modal(document.getElementById('transactionModal'));
            modal.show();
            document.getElementById('modalAccountId').textContent = accountId;
            document.getElementById('modalLoading').style.display = 'block';
            document.getElementById('modalError').style.display = 'none';
            document.getElementById('modalContent').style.display = 'none';
            
            fetch('@Url.Action("GetCustomerTransactionHistory", "Dashboard")?accountId=' + accountId)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('modalLoading').style.display = 'none';
                    document.getElementById('modalContent').style.display = 'block';
                    
                    if (data.success && data.data && data.data.length > 0) {
                        document.getElementById('noTransactions').style.display = 'none';
                        var html = '';
                        data.data.forEach(function(t) {
                            var date = new Date(t.Transactiondate || t.Transationdate);
                            var isCredit = t.Transactiontype.toUpperCase().includes('DEPOSIT') || 
                                          t.Transactiontype.toUpperCase().includes('CREDIT');
                            var icon = isCredit ? 'arrow-down-circle text-success' : 'arrow-up-circle text-danger';
                            var sign = isCredit ? '+' : '-';
                            var amountClass = isCredit ? 'text-success' : 'text-danger';
                            
                            html += `<div class="transaction-item d-flex justify-content-between">
                                <div>
                                    <i class="bi bi-${icon} me-2"></i>
                                    <strong>${t.Transactiontype}</strong><br>
                                    <small class="text-muted">${date.toLocaleDateString()} ${date.toLocaleTimeString()}</small>
                                </div>
                                <div class="${amountClass} fw-bold">${sign}₹ ${t.Amount.toFixed(2)}</div>
                            </div>`;
                        });
                        document.getElementById('transactionList').innerHTML = html;
                    } else {
                        document.getElementById('noTransactions').style.display = 'block';
                    }
                })
                .catch(error => {
                    document.getElementById('modalLoading').style.display = 'none';
                    document.getElementById('modalError').textContent = 'Error: ' + error.message;
                    document.getElementById('modalError').style.display = 'block';
                });
        }

        // FD Calculator
        document.addEventListener('DOMContentLoaded', function() {
            const fdAmountInput = document.getElementById('fdAmount');
            const fdTenureSelect = document.getElementById('fdTenure');
            const fdMaturityInput = document.getElementById('fdMaturityAmount');
            const fdCalcDiv = document.getElementById('fdCalculation');

            if (fdAmountInput && fdTenureSelect) {
                function calculateFDMaturity() {
                    const amount = parseFloat(fdAmountInput.value);
                    const tenure = parseInt(fdTenureSelect.value);

                    if (!amount || !tenure || amount < 10000) {
                        fdMaturityInput.value = '';
                        fdCalcDiv.style.display = 'none';
                        return;
                    }

                    // Determine interest rate based on tenure
                    let rate = 6; // Default
                    if (tenure >= 36) rate = 8;
                    else if (tenure >= 12) rate = 7;

                    // Calculate maturity: A = P(1 + r/100)^(t/12)
                    const years = tenure / 12;
                    const maturity = amount * Math.pow(1 + rate / 100, years);

                    fdMaturityInput.value = '₹ ' + maturity.toFixed(2);

                    // Show calculation
                    document.getElementById('fdCalcAmount').textContent = amount.toFixed(2);
                    document.getElementById('fdCalcRate').textContent = rate;
                    document.getElementById('fdCalcTenure').textContent = tenure;
                    document.getElementById('fdCalcMaturity').textContent = maturity.toFixed(2);
                    fdCalcDiv.style.display = 'block';
                }

                fdAmountInput.addEventListener('input', calculateFDMaturity);
                fdTenureSelect.addEventListener('change', calculateFDMaturity);
            }

            // Loan Eligibility Calculator
            const salaryInput = document.getElementById('monthlySalary');
            const loanAmountInput = document.getElementById('loanAmount');
            const tenureInput = document.getElementById('tenureMonths');
            const emiInput = document.getElementById('estimatedEmi');
            const submitBtn = document.getElementById('loanSubmitBtn');

            if (salaryInput && loanAmountInput) {
                let eligibility = null;

                salaryInput.addEventListener('input', function() {
                    const salary = parseFloat(this.value);
                    
                    if (salary >= 1000) {
                        eligibility = calculateLoanEligibility(salary);
                        displayLoanEligibility(eligibility);
                        validateLoanAmount();
                    } else {
                        document.getElementById('loanEligibilityCard').style.display = 'none';
                        document.getElementById('loanValidationMessage').style.display = 'none';
                        submitBtn.disabled = true;
                    }
                });

                loanAmountInput.addEventListener('input', validateLoanAmount);
                tenureInput.addEventListener('input', function() {
                    calculateEMI();
                    validateLoanAmount();
                });

                function calculateLoanEligibility(salary) {
                    const minLoan = salary * 30;
                    const maxLoan = salary * 60;
                    const maxEmi = salary * 0.6;
                    
                    let interestRate = 10;
                    if (maxLoan >= 1000000) {
                        interestRate = 9;
                    } else if (maxLoan >= 500000) {
                        interestRate = 9.5;
                    }

                    return {
                        minLoan: minLoan,
                        maxLoan: maxLoan,
                        maxEmi: maxEmi,
                        interestRate: interestRate,
                        salary: salary
                    };
                }

                function displayLoanEligibility(eligibility) {
                    const card = document.getElementById('loanEligibilityCard');
                    document.getElementById('loanRange').textContent = `₹${formatCurrency(eligibility.minLoan)} to ₹${formatCurrency(eligibility.maxLoan)}`;
                    document.getElementById('interestRate').textContent = `${eligibility.interestRate}% per annum`;
                    document.getElementById('maxEmi').textContent = `₹${formatCurrency(eligibility.maxEmi)}/month`;
                    card.style.display = 'block';
                }

                function validateLoanAmount() {
                    const loanAmount = parseFloat(loanAmountInput.value);
                    const msgDiv = document.getElementById('loanValidationMessage');

                    if (!eligibility || !loanAmount) {
                        msgDiv.style.display = 'none';
                        submitBtn.disabled = true;
                        return;
                    }

                    if (loanAmount < eligibility.minLoan) {
                        msgDiv.className = 'alert alert-warning';
                        msgDiv.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Low Amount:</strong> Based on salary of ₹${formatCurrency(eligibility.salary)}, 
                            minimum recommended loan is ₹${formatCurrency(eligibility.minLoan)}`;
                        msgDiv.style.display = 'block';
                        submitBtn.disabled = false;
                    } else if (loanAmount > eligibility.maxLoan) {
                        msgDiv.className = 'alert alert-danger';
                        msgDiv.innerHTML = `<i class="bi bi-x-circle me-2"></i>
                            <strong>Exceeds Eligibility:</strong> Maximum loan for salary ₹${formatCurrency(eligibility.salary)} 
                            is ₹${formatCurrency(eligibility.maxLoan)}. Please reduce loan amount.`;
                        msgDiv.style.display = 'block';
                        submitBtn.disabled = true;
                    } else {
                        msgDiv.className = 'alert alert-success';
                        msgDiv.innerHTML = `<i class="bi bi-check-circle me-2"></i>
                            <strong>Eligible!</strong> Loan amount ₹${formatCurrency(loanAmount)} is within your eligibility range.`;
                        msgDiv.style.display = 'block';
                        submitBtn.disabled = false;
                        calculateEMI();
                    }
                }

                function calculateEMI() {
                    const loanAmount = parseFloat(loanAmountInput.value);
                    const tenure = parseInt(tenureInput.value);

                    if (!eligibility || !loanAmount || !tenure) {
                        emiInput.value = '';
                        return;
                    }

                    const monthlyRate = (eligibility.interestRate / 12) / 100;
                    const emi = (loanAmount * monthlyRate * Math.pow(1 + monthlyRate, tenure)) / 
                                (Math.pow(1 + monthlyRate, tenure) - 1);

                    emiInput.value = '₹ ' + formatCurrency(emi);

                    if (emi > eligibility.maxEmi) {
                        const msgDiv = document.getElementById('loanValidationMessage');
                        msgDiv.className = 'alert alert-danger';
                        msgDiv.innerHTML = `<i class="bi bi-x-circle me-2"></i>
                            <strong>EMI Too High:</strong> EMI ₹${formatCurrency(emi)} exceeds 60% of salary 
                            (₹${formatCurrency(eligibility.maxEmi)}). Increase tenure or reduce loan amount.`;
                        submitBtn.disabled = true;
                    }
                }

                function formatCurrency(amount) {
                    return new Intl.NumberFormat('en-IN', {
                        maximumFractionDigits: 0
                    }).format(amount);
                }
            }
        });

        // Auto-show section after action
        @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
        {
            <text>
            window.addEventListener('load', function() {
                var message = '@Html.Raw(TempData["SuccessMessage"] ?? TempData["ErrorMessage"] ?? "")'.toLowerCase();
                if (message.indexOf('transfer') >= 0) {
                    showSection('history');
                    setTimeout(function() {
                        var viewButton = document.querySelector('#history .btn-primary');
                        if (viewButton) viewButton.click();
                    }, 500);
                } else if (message.indexOf('emi') >= 0 || message.indexOf('loan') >= 0) {
                    showSection('pay-emi');
                } else if (message.indexOf('fixed deposit') >= 0 || message.indexOf('fd') >= 0) {
                    // Scroll to top to see alert
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else if (message.indexOf('loan application') >= 0 || message.indexOf('loan') >= 0) {
                    // Scroll to top to see alert
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            });
            </text>
        }
    </script>
}
